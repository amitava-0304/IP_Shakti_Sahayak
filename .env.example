# AI providers
GEMINI_API_KEY=
GROQ_API_KEY=

# Ayurveda centre search
SERPAPI_API_KEY=

# Local default: leave STORAGE_ROOT unset.
# Railway: attach a persistent volume at /app/storage
# and set:
STORAGE_ROOT=/app/storage

# Build main Chroma collection automatically if empty.
AUTO_INGEST_ON_START=true

# Normally keep false.
# Set true only when you intentionally want to rebuild
# the main knowledge base from data/ on every restart.
REBUILD_MAIN_ON_START=false
